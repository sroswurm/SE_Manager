  "definitions": {
    "outcome": "won = agreement, purchase order or email acceptance received. lost = declined or awarded elsewhere. pending = proposal out or not yet sent.",
    "billing_status": "not_invoiced = work done but no invoice sent. invoiced = invoice issued, awaiting payment. paid = payment received in full. partial = some payment received, balance outstanding. null for lost/pending jobs.",
    "job_complete": "true once the last deliverable is issued and the last invoice sent. false while work remains. null when the job is not won.",
    "dateRFP": "Date the request for proposal or inquiry was received. YYYY-MM-DD.",
    "dateQuoted": "Date the proposal or quote was sent to the client. null if not yet quoted.",
    "dateAwarded": "Date the job was awarded (won) or lost notification received. null for pending jobs.",
    "quoted_fee": "Latest fee agreed (won) or proposed (pending). For not-to-exceed jobs, the cap. null if no proposal has been sent.",
    "final_fee": "Total billed at completion, including additional services. null until job_complete is true.",
    "amount_invoiced": "Total dollar amount invoiced to date across all milestones. null if nothing invoiced yet.",
    "amount_paid": "Total dollar amount received from the client to date. null if nothing received.",
    "balance_due": "amount_invoiced minus amount_paid. Represents outstanding receivables. null if nothing invoiced.",
    "hours_spent": "All hours charged to the job to date, including pre-award proposal time.",
    "invoices": "List of invoices issued for this job. Each entry has dateIssued (YYYY-MM-DD when the invoice was sent) and datePaid (YYYY-MM-DD when full payment was received; null if unpaid or only partially paid)."
  },
